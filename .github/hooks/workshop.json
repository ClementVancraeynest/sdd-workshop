{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "sh workshop/hooks/start.sh",
        "cwd": ".",
        "timeoutSec": 30
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "sh workshop/hooks/guard.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "sh workshop/hooks/follow.sh",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
